{
  "info": {
    "name": "Chat App Backend",
    "description": "Real-time Chat Application API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"rahul\",\n  \"email\": \"rahul@test.com\",\n  \"password\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"rahul@test.com\",\n  \"password\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "Auth - Get Me",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/me",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "Auth - Search Users",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/auth/search?q=rah",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "search"],
          "query": [
            {
              "key": "q",
              "value": "rah"
            }
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "Chat - Create Chat",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chat",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"USER_ID_HERE\"\n}"
        }
      }
    },
    {
      "name": "Chat - Get All Chats",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/chat",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "Chat - Get Messages",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/chat/CHAT_ID_HERE/messages",
          "host": ["{{baseUrl}}"],
          "path": ["api", "chat", "CHAT_ID_HERE", "messages"]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "Chat - Create Group",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chat/group",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"My Group\",\n  \"users\": [\"USER_ID_1\", \"USER_ID_2\"]\n}"
        }
      }
    }
  ]
}
